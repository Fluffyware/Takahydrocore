/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google.com https://maps.gstatic.com https://*.googleusercontent.com; media-src 'self'; frame-src https://www.google.com https://docs.google.com; connect-src 'self' https://identity.netlify.com https://api.netlify.com https://api.github.com; form-action 'self' mailto: https://docs.google.com; upgrade-insecure-requests

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/data/*
  Cache-Control: public, max-age=60, stale-while-revalidate=300

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
